COMPOSE_PROJECT_NAME=teacher-agent

TEACHER_HTTP_BIND=127.0.0.1
TEACHER_HTTP_PORT=8080
TEACHER_INGEST_PORT=8081

# HTTPS reverse proxy (compose/docker-compose.proxy.yml, part of `make dev-up`). See docs/https.md.
# Name or IP the browser/phone uses; the certificate is issued for it. Use the host's VPN/LAN name or IP for phones.
TEACHER_PROXY_HOST=localhost
# 127.0.0.1 = this machine only. Use 0.0.0.0 (or the VPN interface address) to reach it from a phone.
TEACHER_PROXY_BIND=127.0.0.1
TEACHER_HTTPS_PORT=8443
TEACHER_PROXY_HTTP_PORT=8088
# `internal` = Caddy's local CA (self-signed, trust its root on each device).
# Real certs: put files in TEACHER_TLS_DIR and set e.g. `/certs/fullchain.pem /certs/privkey.pem`.
TEACHER_TLS=internal
TEACHER_TLS_DIR=../certs
# Strict-Transport-Security value. Keep max-age=0 until real certs are in place, then max-age=31536000.
TEACHER_HSTS=max-age=0
TEACHER_QDRANT_PORT=6333
TEACHER_OLLAMA_PORT=11434

TEACHER_STACK_DIR=/opt/teacher-agent
TEACHER_DATA_DIR=/srv/teacher-agent
TEACHER_MOUNT_POINT=/mnt/library

# App login. One or more `username:argon2-hash` entries separated by `;`.
# Make a hash with `make hash-password`. Keep the value in single quotes: the hash contains `$`.
# Example: TEACHER_AUTH_USERS='apa:$argon2id$v=19$m=65536,t=3,p=4$...;anya:$argon2id$...'
TEACHER_AUTH_USERS=''
# Alternative: path inside the api container to a file with one `username:hash` per line.
TEACHER_AUTH_USERS_FILE=
# Comma-separated usernames with system-wide admin access; all others are regular users.
TEACHER_AUTH_ADMINS=
# Only for throwaway local experiments. Never on a reachable host.
TEACHER_AUTH_DISABLED=false
# How long a login lasts on a device.
TEACHER_SESSION_TTL_HOURS=720
# auto: Secure cookie when the request arrived over HTTPS (directly or via X-Forwarded-Proto).
# Set to true once the app is only reached through HTTPS.
TEACHER_COOKIE_SECURE=auto
# Failed logins allowed per client address and per user within the window.
TEACHER_LOGIN_MAX_ATTEMPTS=10
TEACHER_LOGIN_WINDOW_SECONDS=900

# Shared secret for the ingestion service's /ingest endpoints (API -> ingestion, ops scripts).
# Generate with: openssl rand -hex 32
TEACHER_INGEST_TOKEN=

TEACHER_GPU_ENABLED=false
TEACHER_LLM_RUNTIME=ollama
TEACHER_VECTOR_DB=qdrant
TEACHER_ENABLE_VOICE=false
TEACHER_ENABLE_REVERSE_PROXY=false
TEACHER_ENABLE_WIREGUARD=false

OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_BASE_URL=http://ollama:11434

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=teacher_documents

EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu

# Watched folders and the schedule live in this YAML file (inside the ingestion container).
INGEST_CONFIG_PATH=/app/config/ingestion/ingestion.yml
# Legacy fixed interval, used only when that file has no `schedule` section (0 = off).
INGEST_SCHEDULE_SECONDS=0
INGEST_REMOVE_MISSING=true
INGEST_SCAN_EXTENSIONS=.pdf,.epub,.txt,.md,.docx,.mobi,.azw,.azw3
INGEST_CHUNK_SIZE=1200
INGEST_CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=6
MAX_CONTEXT_CHARS=18000
STUDY_TOP_K=10
STUDY_MAX_ATTEMPTS=2

VOICE_BASE_URL=http://voice:8090
VOICE_STT_BACKEND=faster-whisper
VOICE_STT_MODEL=base
VOICE_STT_DEVICE=auto
VOICE_TTS_BACKEND=disabled

OCR_ENABLED=true
OCR_DPI=300
OCR_LANGUAGE=hun+eng
# Pages with fewer extracted characters than this are treated as scanned
OCR_MIN_CHARS=50
# Per-file OCR time budget in seconds (0 = unlimited); finished pages are cached and kept
OCR_TIMEOUT_SECONDS=900
# Max pages OCR'd per file (0 = unlimited)
OCR_MAX_PAGES=0
# Local OCR result cache (never on the read-only library share)
OCR_CACHE_DIR=/data/metadata/ocr_cache

