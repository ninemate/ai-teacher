{{ teacher_caddy_domain }} {
  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000"

  {% if teacher_caddy_username and teacher_caddy_password_hash %}
  basicauth {
    {{ teacher_caddy_username }} {{ teacher_caddy_password_hash }}
  }
  {% endif %}

  # The stack's own compose proxy is the API's only published port (HTTPS, internal CA).
  # The private services publish no host ports, so this host Caddy terminates TLS named
  # after real certificates and forwards to the compose proxy; the internal CA is not
  # verified here, app auth stays on (docs/security.md).
  reverse_proxy https://127.0.0.1:{{ teacher_https_port }} {
    transport http {
      tls_insecure_skip_verify
    }
  }
}
