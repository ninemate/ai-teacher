COMPOSE_PROJECT_NAME=teacher-agent

TEACHER_HTTP_BIND={{ teacher_http_bind }}
TEACHER_HTTP_PORT={{ teacher_http_port }}
TEACHER_INGEST_PORT={{ teacher_ingest_port }}
TEACHER_QDRANT_PORT={{ teacher_qdrant_port }}
TEACHER_OLLAMA_PORT={{ teacher_ollama_port }}

TEACHER_STACK_DIR={{ teacher_stack_dir }}
TEACHER_DATA_DIR={{ teacher_data_dir }}
TEACHER_MOUNT_POINT={{ teacher_mount_point }}

TEACHER_AUTH_USERNAME={{ teacher_auth_username }}
TEACHER_AUTH_PASSWORD={{ teacher_auth_password }}

TEACHER_GPU_ENABLED={{ teacher_gpu_enabled | lower }}
TEACHER_LLM_RUNTIME={{ teacher_llm_runtime }}
TEACHER_VECTOR_DB={{ teacher_vector_db }}
TEACHER_ENABLE_VOICE={{ teacher_enable_voice | lower }}
TEACHER_ENABLE_REVERSE_PROXY={{ teacher_enable_reverse_proxy | lower }}
TEACHER_ENABLE_WIREGUARD={{ teacher_enable_wireguard | lower }}

OLLAMA_MODEL={{ teacher_llm_model }}
OLLAMA_BASE_URL=http://ollama:11434

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=teacher_documents

EMBEDDING_MODEL={{ teacher_embedding_model }}
EMBEDDING_DEVICE={{ teacher_embedding_device }}

INGEST_SCHEDULE_SECONDS={{ teacher_ingest_schedule_seconds }}
INGEST_REMOVE_MISSING={{ teacher_ingest_remove_missing | lower }}
INGEST_SCAN_EXTENSIONS={{ teacher_ingest_scan_extensions }}
INGEST_CHUNK_SIZE={{ teacher_ingest_chunk_size }}
INGEST_CHUNK_OVERLAP={{ teacher_ingest_chunk_overlap }}
RETRIEVAL_TOP_K={{ teacher_retrieval_top_k }}
MAX_CONTEXT_CHARS={{ teacher_max_context_chars }}

VOICE_BASE_URL=http://voice:8090
VOICE_STT_BACKEND={{ teacher_voice_stt_backend }}
VOICE_STT_MODEL={{ teacher_voice_stt_model }}
VOICE_STT_DEVICE={{ teacher_voice_stt_device }}
VOICE_TTS_BACKEND={{ teacher_voice_tts_backend }}

OCR_ENABLED={{ teacher_ocr_enabled | lower }}
OCR_DPI={{ teacher_ocr_dpi }}
OCR_LANGUAGE={{ teacher_ocr_language }}

